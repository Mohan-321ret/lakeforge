# Lakeforge Configuration

# LLM Configuration
LLM_PROVIDER=groq  # Options: groq, ollama, gemini
GROQ_API_KEY=YOUR_GROQ_API_KEY
OLLAMA_BASE_URL=http://localhost:11434

# Output Configuration
LAKEFORGE_OUTPUT_DIR=./.lakeforge
LAKEFORGE_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Query Configuration
MAX_QUERY_TIMEOUT_SEC=30
MAX_RESULT_BYTES=10485760  # 10MB
MAX_SAMPLE_ROWS=1000

# Cost Configuration
MAX_COST_PER_RUN=1.0

# Databricks Configuration (optional)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_ID=

# Postgres Configuration (optional)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PII Configuration
PII_DETECTION_METHOD=regex  # regex or llm
PII_MASKING_METHOD=hash  # hash or redact
